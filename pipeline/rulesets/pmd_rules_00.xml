<?xml version="1.0"?>
<ruleset name="Smell-Ranker-Targeted"
    xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">

    <description>
        Targeted ruleset for Smell-Ranker.
        References standard PMD definitions without modification to ensure state-of-the-art thresholds.
    </description>

    <!--
      We reference the specific rules we need from the standard categories.
      This avoids running the hundreds of other rules in 'design.xml'.
    -->

    <!-- God Class Detection -->
    <rule ref="category/java/design.xml/GodClass" />

    <!-- Long Method Detection -->
    <rule ref="category/java/design.xml/ExcessiveMethodLength" />

    <!-- Long Class Detection (often correlated with God Class) -->
    <rule ref="category/java/design.xml/ExcessiveClassLength" />

</ruleset>