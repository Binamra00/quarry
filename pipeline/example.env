# ==============================================================================
# SMELL-RANKER ENVIRONMENT CONFIGURATION (example.env)
# ==============================================================================

SMELL_RANKER_HOME=

# --- Core Pipeline Strategy ---
# Choose the structural analysis engine: 'ck' (Aniche metrics) or 'pmd' (Legacy rules)
STRUCTURAL_TOOL=ck

# --- Toolchain Versions ---
CK_VERSION=0.7.0
RM_VERSION=3.1.3
PMD_VERSION=7.24.0

# --- Toolchain URLs ---
CK_URL=https://repo1.maven.org/maven2/com/github/mauricioaniche/ck/0.7.0/ck-0.7.0-jar-with-dependencies.jar
RM_URL=https://github.com/tsantalis/RefactoringMiner/releases/download/3.1.3/RefactoringMiner-3.1.3.zip
PMD_URL=https://github.com/pmd/pmd/releases/download/pmd_releases%2F7.24.0/pmd-dist-7.24.0-bin.zip

# --- Security Checksums (SHA-256) ---
CK_SHA256=REPLACE_WITH_ACTUAL_CK_0_7_0_HASH
RM_SHA256=71be3a02d9e116340b6532a821f1cd2aea126cbf81aeb894905b9cc19099ee4d
PMD_SHA256=REPLACE_WITH_ACTUAL_PMD_7_24_0_HASH

# --- Pipeline Configuration ---
IO_MAX_RETRIES=5
IO_RETRY_DELAY_BASE=0.1