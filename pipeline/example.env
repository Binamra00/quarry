# ==============================================================================
# SMELL-RANKER ENVIRONMENT CONFIGURATION (example.env)
# ==============================================================================

SMELL_RANKER_HOME=

# --- Toolchain Versions ---
# CK is the structural analysis engine (Aniche metrics). RefactoringMiner detects
# refactorings. These are the only two external tools the pipeline provisions.
CK_VERSION=0.7.0
RM_VERSION=3.1.3

# --- Toolchain URLs ---
CK_URL=https://repo1.maven.org/maven2/com/github/mauricioaniche/ck/0.7.0/ck-0.7.0-jar-with-dependencies.jar
RM_URL=https://github.com/tsantalis/RefactoringMiner/releases/download/3.1.3/RefactoringMiner-3.1.3.zip

# --- Security Checksums (SHA-256) ---
# Populate via generate_hashes.py, or leave blank to skip verification.
CK_SHA256=REPLACE_WITH_ACTUAL_CK_0_7_0_HASH
RM_SHA256=REPLACE_WITH_ACTUAL_REFM_3_1_3_HASH

# --- CK Execution Limits (large-repo safety) ---
# CK checks out and analyzes each snapshot; QuestDB/checkstyle need headroom.
CK_TIMEOUT=3600
JAVA_XMX=4g

# --- Pipeline I/O Resilience ---
IO_MAX_RETRIES=5
IO_RETRY_DELAY_BASE=0.1